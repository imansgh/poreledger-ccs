# Backend (FastAPI) configuration. No secrets are required -- the service has
# no authentication yet. The backend reads these from the PROCESS ENVIRONMENT;
# it does not read a .env file by itself. Use them by exporting them in your
# shell, through `docker compose` (see docker-compose.yml), or through your
# hosting platform's environment settings. Never commit a filled-in .env.

# Directory holding the OPTIONAL existing well dataset. User assessments (the
# primary workflow) need no dataset; a missing directory only makes
# /ready/existing-data answer 503. Choose explicitly:
#   demo/data  -> the bundled SYNTHETIC demonstration dataset (fictional wells)
#   data       -> the real structured sources (not distributed; see docs/data-contribution.md)
# A missing real directory never falls back to the demo.
CCS_DATA_DIR=demo/data

# Comma-separated list of browser origins allowed to call the API.
# EMPTY BY DEFAULT: cross-origin access is off until you name origins here.
# There is no wildcard default, and "*" should not be used. It must match the
# website origin exactly (scheme, host and port).
CCS_CORS_ORIGINS=http://localhost:3000

# Maximum JSON request body in bytes (default 16384).
CCS_MAX_BODY_BYTES=16384

# Separate cap for /assessments/* requests, which carry uploaded files (default 262144).
CCS_MAX_ASSESSMENT_BODY_BYTES=262144

# Normalize the dataset at startup so the first request is not slow.
CCS_WARM_CACHE=1

# Set to 0 to disable the interactive /docs and /redoc pages in production.
CCS_DOCS=1
