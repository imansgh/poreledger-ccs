# Backend (FastAPI) configuration. Copy to .env and adjust; never commit .env.
# No secrets are required -- the service has no authentication yet.

# Directory holding the structured well sources.
CCS_DATA_DIR=data

# Comma-separated list of browser origins allowed to call the API.
# EMPTY BY DEFAULT: cross-origin access is off until you name origins here.
# There is no wildcard default, and "*" should not be used.
# Development example:
CCS_CORS_ORIGINS=http://localhost:3000

# Maximum JSON request body in bytes (default 16384).
CCS_MAX_BODY_BYTES=16384

# Normalize the dataset at startup so the first request is not slow.
CCS_WARM_CACHE=1

# Set to 0 to disable the interactive /docs and /redoc pages in production.
CCS_DOCS=1
