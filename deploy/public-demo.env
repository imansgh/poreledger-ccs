# Backend environment for the PUBLIC PoreLedger CCS demo.
# Enter these in the hosting platform's environment settings (or pass them to
# `docker run --env-file deploy/public-demo.env`). No secrets: none are needed.
# See docs/deployment.md and docs/public-release.md.

# No existing-well dataset: the demo serves user assessments and the shipped
# synthetic examples only. This path does not exist in the image on purpose,
# so /ready/existing-data answers 503 and the real dataset can never be served.
CCS_DATA_DIR=/app/no-existing-well-dataset

# The ORIGIN (scheme + host, no path) of the page that runs the website. With
# the website on GitHub Pages at https://imansgh.github.io/poreledger-ccs/ this
# is https://imansgh.github.io -- also when that page is embedded in an iframe
# on imansgh.me, because the iframe's own origin makes the requests. Change it
# if the website is served from a custom domain.
CCS_CORS_ORIGINS=https://imansgh.github.io

# Request-size caps (the defaults, stated explicitly).
CCS_MAX_BODY_BYTES=16384
CCS_MAX_ASSESSMENT_BODY_BYTES=262144

# Abuse controls for a single public process (0 turns a control off).
# 20 POSTs per client per minute is ample for interactive use (each calculation
# is one request); at most 2 Monte Carlo runs at once, others get 503 + Retry-After.
CCS_RATE_LIMIT_PER_MINUTE=20
CCS_MAX_CONCURRENT_EVALUATIONS=2

# Trust the platform's proxy for the client address used by the rate limit.
# Only safe where the container is reachable exclusively through that proxy
# (true on managed container platforms); otherwise list the proxy addresses.
FORWARDED_ALLOW_IPS=*

# Interactive API docs at /docs; harmless, set to 0 to hide them.
CCS_DOCS=1
CCS_WARM_CACHE=1
