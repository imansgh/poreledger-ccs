# Frontend (Next.js) configuration. Copy to .env.local for local development.
# No secrets: every NEXT_PUBLIC_* value is compiled into the JavaScript bundle
# and visible to every visitor.

# Base URL of the FastAPI backend. BUILD-TIME: it is inlined by `next build`,
# so changing it requires a rebuild. The backend's CCS_CORS_ORIGINS must list
# the origin this site is served from.
NEXT_PUBLIC_CCS_API_URL=http://127.0.0.1:8000

# Optional BUILD-TIME website subpath. Empty for local/root hosting.
# npm run build:static defaults to /poreledger-ccs unless explicitly overridden.
# NEXT_PUBLIC_CCS_BASE_PATH=/poreledger-ccs

# Optional, BUILD-TIME: a public repository URL. When set (https only), the
# site links to it; when unset, no repository link is shown.
# NEXT_PUBLIC_CCS_REPO_URL=
